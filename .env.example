# Supabase 대시보드 > Project Settings > API (또는 Connect 버튼)에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 새 프로젝트는 publishable key(sb_publishable_...), 예전 프로젝트는 anon key 를 넣으면 된다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# (선택) Cloudflare Turnstile CAPTCHA. 켜려면 Supabase Auth 설정에도 secret 을 등록해야 한다
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 주의: service_role / secret key 는 절대 여기에 넣지 않는다 (브라우저에 노출됨)
